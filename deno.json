{
	"tasks": {
		"serve-pa": "deno run --allow-read --allow-write --allow-net --unstable-kv --unstable-cron mappo-pa.ts",
		"serve-otel-pa": "OTEL_DENO=true OTEL_SERVICE_NAME=mappo-pa deno run serve-pa --unstable-otel",
	},
	"imports": {
		"@mappo-aggregato/mappo-aggregato": "jsr:@mappo-aggregato/mappo-aggregato@^0.1.7",
		"@oak/oak": "jsr:@oak/oak@^17.1.5",
		"@std/assert": "jsr:@std/assert@1",
		"rxjs": "npm:rxjs@^7.8.2"
	},
	"fmt": {
		"semiColons": false,
		"useTabs": true,
		"indentWidth": 4,
		"lineWidth": 120
	}
}
