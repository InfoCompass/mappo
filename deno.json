{
	"tasks": {
		"serve-pa": "deno run --allow-read --allow-write --allow-net --unstable-kv --unstable-cron mappo-pa.ts",
		"serve-otel-pa": "OTEL_DENO=true deno run serve-pa --unstable-otel",
		"ensure-pup": "pup --version || deno run -Ar jsr:@pup/pup setup",
		"start":"deno run ensure-pup && pup run --enable-service"
	},
	"imports": {
		"@mappo-aggregato/mappo-aggregato": "jsr:@mappo-aggregato/mappo-aggregato@^0.1.4",
		"@oak/oak": "jsr:@oak/oak@^17.1.5",
		"@std/assert": "jsr:@std/assert@1",
		"rxjs": "npm:rxjs@^7.8.2"
	},
	"fmt": {
		"semiColons": false,
		"useTabs": true,
		"indentWidth": 4,
		"lineWidth": 120
	}
}
