{
	"tasks": {
		"serve-pa": "deno run --allow-read --allow-write --allow-net --unstable-kv --unstable-cron src/mappo-pa.ts",
		"serve-otel-pa": "OTEL_DENO=true OTEL_SERVICE_NAME=mappo-pa deno run serve-pa --unstable-otel",

		"serve-at": "deno run --allow-read --allow-write --allow-net --unstable-kv --unstable-cron src/mappo-at.ts",
		"serve-otel-at": "OTEL_DENO=true OTEL_SERVICE_NAME=mappo-at deno run serve-at --unstable-otel",
		
		"serve-at-tt": "deno run --allow-read --allow-write --allow-net --unstable-kv --unstable-cron src/mappo-at-tt.ts",
		"serve-otel-at-tt": "OTEL_DENO=true OTEL_SERVICE_NAME=mappo-at-tt deno run serve-at-tt --unstable-otel",

		"serve-potsdam": "deno run --allow-read --allow-write --allow-net --unstable-kv --unstable-cron src/mappo-potsdam.ts",
		"serve-otel-potsdam": "OTEL_DENO=true OTEL_SERVICE_NAME=mappo-potsdam deno run serve-potsdam --unstable-otel",


		"serve-all": "deno run --allow-read --allow-write --allow-net --unstable-kv --unstable-cron src/mappo-all.ts",
		"serve-otel-all": "OTEL_DENO=true OTEL_SERVICE_NAME=mappo-all deno run serve-all --unstable-otel",
	},
	"imports": {
		"@mappo-aggregato/mappo-aggregato": "jsr:@mappo-aggregato/mappo-aggregato@^0.1.17",
		"@oak/oak": "jsr:@oak/oak@^17.2.0",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"rxjs": "npm:rxjs@^7.8.2"
	},
	"fmt": {
		"semiColons": false,
		"useTabs": true,
		"indentWidth": 4,
		"lineWidth": 120
	}
}
